{
  "name": "novara-academy",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "LIVE_AI_ENABLED": "true",
    "ADMISSIONS_AI": "on",
    "ADMISSIONS_DAILY_LIMIT": "15"
  },
  "d1_databases": [
    {
      "binding": "DATA_DB",
      "database_name": "novara-data"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
